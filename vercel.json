{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/clients",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/agents",
      "destination": "/partners",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/calendar-fill",
      "schedule": "5 20 * * *"
    }
  ]
}
