# Vercel Environment Variables (set these in Vercel Dashboard -> Settings -> Environment Variables)
# Never commit actual secrets to git.

CAL_API_KEY=cal_live_...
ZIINA_API_KEY=...
ZIINA_TEST_MODE=true
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Vantage North <bookings@vantagenorth.ae>
ADMIN_NOTIFICATION_EMAIL=bookings@vantagenorth.ae
# Where payment health alerts go (falls back to ADMIN_NOTIFICATION_EMAIL)
PAYMENT_ALERT_EMAIL=

# Shared secret for /api/payment-health. Must match the
# payment_health_cron_secret stored in Supabase Vault.
CRON_SECRET=

# Supabase (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Base site URL
SITE_URL=https://vantagenorth.ae
