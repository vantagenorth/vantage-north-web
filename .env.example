# Vercel Environment Variables (set these in Vercel Dashboard -> Settings -> Environment Variables)
# Never commit actual secrets to git.

CAL_API_KEY=cal_live_...
ZIINA_API_KEY=...
ZIINA_TEST_MODE=true
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Vantage North <bookings@vantagenorth.ae>
ADMIN_NOTIFICATION_EMAIL=bookings@vantagenorth.ae
# Where payment health alerts go (falls back to ADMIN_NOTIFICATION_EMAIL)
PAYMENT_ALERT_EMAIL=

# Shared secret for /api/payment-health. Must match the
# CRON_SECRET secret stored in Supabase Vault.
CRON_SECRET=

# Supabase (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Base site URL
SITE_URL=https://vantagenorth.ae

# Self-service reschedule/cancel pages. Leave unset until the subdomains' DNS is live;
# links then use https://vantagenorth.ae/reschedule/{ref} and /cancel/{ref}.
MANAGE_RESCHEDULE_BASE_URL=https://reschedule.vantagenorth.ae
MANAGE_CANCEL_BASE_URL=https://cancel.vantagenorth.ae
# Minutes before the start when online rescheduling closes (default 120).
MANAGE_RESCHEDULE_CUTOFF_MINUTES=120
# "true" refunds cancellations through Ziina's refund API. Off: Andy gets an email to refund by hand.
ZIINA_AUTO_REFUND=false
